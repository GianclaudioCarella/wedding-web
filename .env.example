# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of admin emails allowed into /admin and /api/admin/*.
# If empty, ANY authenticated Supabase user is treated as admin.
ADMIN_EMAILS=

# Public base URL used in email links (e.g. https://giancat.com)
NEXT_PUBLIC_APP_URL=

# Key used to encrypt per-user API keys stored in user_settings
ENCRYPTION_KEY=

# Email (Resend is the only provider)
RESEND_API_KEY=
# Sender, e.g. "Gian & Cat <hello@your-verified-domain.com>"
RESEND_FROM_EMAIL=
# Optional: CC copy and Reply-To for every outgoing email
EMAIL_CC=
EMAIL_REPLY_TO=

# Used only by scripts/examples (metrics examples)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

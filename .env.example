# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Access is per wedding (public.wedding_members). TEMPORARY transition
# bootstrap only: e-mails listed here count as owner of the default wedding in
# server routes until owners exist in wedding_members. Empty = nobody.
# Remove after the Phase 1 rollout (docs/multi-wedding/PHASE1-ROLLOUT.md).
ADMIN_EMAILS=

# Wedding served by this deployment until Phase 2 routing. Leave empty for
# tenant #1 (00000000-0000-0000-0000-000000000001).
NEXT_PUBLIC_DEFAULT_WEDDING_ID=

# Public base URL used to build guest links in e-mails (required in production)
NEXT_PUBLIC_APP_URL=

# Key used to encrypt per-user API keys stored in user_settings
ENCRYPTION_KEY=

# Email (Resend is the only provider)
RESEND_API_KEY=
# Sender, e.g. "Gian & Cat <hello@your-verified-domain.com>"
RESEND_FROM_EMAIL=
# Optional: CC copy and Reply-To for every outgoing email
EMAIL_CC=
EMAIL_REPLY_TO=

# Used only by scripts/examples (metrics examples)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of admin emails allowed into /admin and /api/admin/*.
# If empty, ANY authenticated Supabase user is treated as admin.
ADMIN_EMAILS=

# Public base URL used in email links (e.g. https://giancat.com)
NEXT_PUBLIC_APP_URL=

# Key used to encrypt per-user API keys stored in user_settings
ENCRYPTION_KEY=

# Email (Gmail SMTP via nodemailer)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_CC=

# Email (Resend, used by test-email.js)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Used only by scripts/examples (test-email.js, metrics examples)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Guest photo album (/album) — S3 values come from `terraform output` in infra/
S3_REGION=eu-west-1
S3_BUCKET=giancat-album
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Shared password guests type on /album (case-insensitive). Changing it logs everyone out.
ALBUM_PASSWORD=
# Random string used to sign the album cookie, e.g. `openssl rand -base64 32`
ALBUM_SESSION_SECRET=
